# PostgreSQL (produção / desenvolvimento)
DATABASE_URL=postgresql+psycopg2://ambros:ambros@localhost:5432/ambros

# Para testes rápidos sem PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./ambros.db

# Chave para assinar os tokens JWT (troque em produção!)
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480
